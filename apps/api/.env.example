# Copiar a .env y completar. Todas las variables llevan el prefijo DUALREC_.
# En AWS estas variables las define la plantilla de infra/aws; este archivo
# sirve para correr la API fuera de AWS contra recursos reales.

# Base de datos: RDS PostgreSQL.
DUALREC_DB_HOST=dualrec.xxxxxxxx.us-east-1.rds.amazonaws.com
DUALREC_DB_NAME=dualrec
DUALREC_DB_USER=dualrec
DUALREC_DB_PASSWORD=CAMBIAR

# Almacenamiento: Amazon S3.
DUALREC_S3_BUCKET=dualrec-media-CAMBIAR
DUALREC_S3_REGION=us-east-1
# Dentro de AWS no hacen falta claves: se usa el rol de IAM.
# DUALREC_S3_ACCESS_KEY_ID=
# DUALREC_S3_SECRET_ACCESS_KEY=

# Dirección pública de la web: con esto se arma el link para compartir.
DUALREC_PUBLIC_WEB_URL=https://dxxxxxxxxxxxx.cloudfront.net
DUALREC_CORS_ORIGINS=https://dxxxxxxxxxxxx.cloudfront.net
# Detrás de CloudFront la API se publica bajo /api.
DUALREC_API_PREFIX=/api

DUALREC_FFMPEG_PATH=ffmpeg
